{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quickshare-cloudflare",
  "main": "src/worker.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "share.stevenli.dpdns.org",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickshare-db",
      "database_id": "6c09d6f0-d11e-4488-a737-9e6b32770dab"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "quickshare-sites"
    }
  ],
  "vars": {
    "SITE_PATH_PREFIX": "/s",
    "MAX_FILES": "1000",
    "MAX_FILE_BYTES": "26214400",
    "MAX_SITE_BYTES": "104857600",
    "MAX_TOTAL_BYTES": "1073741824",
    "MAX_VERSIONS_PER_SITE": "20"
  },
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 6000, "period": 60 } },
    { "name": "READ_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 1200, "period": 60 } }
  ],
  "secrets": {
    "required": ["ADMIN_PASSWORD", "COOKIE_SIGNING_KEY"]
  },
  "observability": {
    "enabled": true
  }
}
